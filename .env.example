# SupportIQ Environment Configuration

# Groq API Configuration (Required for live LLM planning)
# Get your free key at https://console.groq.com
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=openai/gpt-oss-120b

# LLM Mode: 'groq' for live API, 'mock' for local offline deterministic testing
LLM_PROVIDER=groq

# Data Configuration
DATA_PATH=data/support_tickets.csv

# Application Settings
APP_ENV=development
LOG_LEVEL=INFO
API_HOST=0.0.0.0
API_PORT=8000
STREAMLIT_PORT=8501

# Anomaly Detection Reference Time Configuration
# 'dataset_max': Uses latest ticket timestamp in dataset (2024-03-30 18:06:00) - best for historical datasets
# 'now': Uses current system wall-clock time
REFERENCE_TIME_MODE=dataset_max

# SLA Thresholds (hours)
SLA_CRITICAL_HOURS=12.0
SLA_HIGH_HOURS=24.0
IQR_MULTIPLIER=1.5
